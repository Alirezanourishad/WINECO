        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB-WINECO"
          },
          "query": "from(bucket: \"WINECO\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"all_iot_data\")\n  |> filter(fn: (r) => r.topic == \"kpi/iaq\")\n  |> filter(fn: (r) => r._field == \"numeric_value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
